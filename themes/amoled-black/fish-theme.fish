# NOTHING theme — AMOLED BLACK (fish)
# Installed to ~/.config/fish/nothing-theme.fish by install.sh / theme-switcher.
set -g NOTHING_THEME "amoled-black"
set -g NOTHING_BG "000000"
set -g NOTHING_FG "ffffff"
set -g NOTHING_MUTED "a3a3a3"
set -g NOTHING_FAINT "6e6e6e"
set -g NOTHING_ACCENT "ffffff"
set -g NOTHING_DANGER "ff5252"

set -g fish_color_normal ffffff
set -g fish_color_command ffffff --bold
set -g fish_color_keyword ffffff --bold
set -g fish_color_quote a3a3a3
set -g fish_color_redirection a3a3a3 --bold
set -g fish_color_end 6e6e6e
set -g fish_color_error ff5252
set -g fish_color_param ffffff
set -g fish_color_comment 6e6e6e
set -g fish_color_match ffffff --background=262626
set -g fish_color_selection --background=ffffff --foreground=000000
set -g fish_color_search_match --background=262626 --foreground=ffffff
set -g fish_color_autosuggestion 6e6e6e
set -g fish_color_cancel 6e6e6e
set -g fish_pager_color_completion ffffff
set -g fish_pager_color_description a3a3a3
set -g fish_pager_color_prefix ffffff --bold
set -g fish_pager_color_progress a3a3a3
set -g fish_pager_color_selected_background --background=ffffff
