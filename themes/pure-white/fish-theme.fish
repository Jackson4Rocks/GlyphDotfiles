# NOTHING theme — PURE WHITE (fish)
# Installed to ~/.config/fish/nothing-theme.fish by install.sh / theme-switcher.
set -g NOTHING_THEME "pure-white"
set -g NOTHING_BG "ffffff"
set -g NOTHING_FG "000000"
set -g NOTHING_MUTED "525252"
set -g NOTHING_FAINT "8a8a8a"
set -g NOTHING_ACCENT "000000"
set -g NOTHING_DANGER "d92626"

set -g fish_color_normal 000000
set -g fish_color_command 000000 --bold
set -g fish_color_keyword 000000 --bold
set -g fish_color_quote 525252
set -g fish_color_redirection 525252 --bold
set -g fish_color_end 8a8a8a
set -g fish_color_error d92626
set -g fish_color_param 000000
set -g fish_color_comment 8a8a8a
set -g fish_color_match 000000 --background=d4d4d4
set -g fish_color_selection --background=000000 --foreground=ffffff
set -g fish_color_search_match --background=d4d4d4 --foreground=000000
set -g fish_color_autosuggestion 8a8a8a
set -g fish_color_cancel 8a8a8a
set -g fish_pager_color_completion 000000
set -g fish_pager_color_description 525252
set -g fish_pager_color_prefix 000000 --bold
set -g fish_pager_color_progress 525252
set -g fish_pager_color_selected_background --background=000000
